<!DOCTYPE html>
<html lang="ar" dir="rtl" class="">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة المكتبة المدرسية الذكي</title>
    <script src="https://tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link rel="stylesheet" href="https://cloudflare.com">
    <link href="https://googleapis.com" rel="stylesheet">
    <style>body { font-family: 'Cairo', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-100 min-h-screen flex flex-col md:flex-row">

    <!-- القائمة الجانبية -->
    <aside class="w-full md:w-64 bg-white dark:bg-gray-800 p-5 flex flex-col justify-between border-l border-gray-200 dark:border-gray-700 shadow-sm">
        <div class="space-y-6">
            <div class="flex items-center space-x-2 space-x-reverse justify-center md:justify-start">
                <i class="fas fa-graduation-cap text-3xl text-indigo-600 dark:text-indigo-400"></i>
                <span class="text-lg font-bold">المكتبة الذكية</span>
            </div>
            
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 space-x-reverse px-4 py-2.5 rounded-lg font-semibold bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                    <i class="fas fa-chart-pie w-5"></i><span>الرئيسية والإحصائيات</span>
                </button>
                <button onclick="switchTab('books')" id="nav-books" class="nav-btn w-full flex items-center space-x-3 space-x-reverse px-4 py-2.5 rounded-lg font-semibold text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50">
                    <i class="fas fa-book w-5"></i><span>إدارة الكتب</span>
                </button>
                <button onclick="switchTab('permissions')" id="nav-permissions" class="nav-btn w-full flex items-center space-x-3 space-x-reverse px-4 py-2.5 rounded-lg font-semibold text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700/50">
                    <i class="fas fa-user-shield w-5"></i><span>إدارة الصلاحيات</span>
                </button>
            </nav>
        </div>

        <button onclick="toggleDarkMode()" class="mt-4 w-full py-2 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 text-sm flex justify-center items-center gap-2">
            <i class="fas fa-moon dark:hidden"></i><i class="fas fa-sun hidden dark:inline"></i>
            <span>تبديل المظهر</span>
        </button>
    </aside>

    <!-- مساحة المحتوى الديناميكية -->
    <main class="flex-1 p-6 md:p-8 overflow-y-auto">
        
        <!-- صفحة الرئيسية والإحصائيات -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <header><h1 class="text-2xl font-bold">لوحة التحكم الرقمية</h1></header>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="p-5 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <div class="text-gray-400 text-sm">إجمالي الكتب المسجلة</div>
                    <div class="text-3xl font-bold mt-2" id="stat-books-count">...</div>
                </div>
                <div class="p-5 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <div class="text-gray-400 text-sm">عمليات الاستعارة النشطة</div>
                    <div class="text-3xl font-bold mt-2 text-orange-500">12 عملية</div>
                </div>
                <div class="p-5 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <div class="text-gray-400 text-sm">المشرفين المتصلين</div>
                    <div class="text-3xl font-bold mt-2 text-green-500" id="stat-users-count">...</div>
                </div>
            </div>
        </section>

        <!-- صفحة إدارة الكتب -->
        <section id="tab-books" class="tab-content hidden space-y-6">
            <div class="flex justify-between items-center">
                <h1 class="text-2xl font-bold">المستودع الرقمي للكتب</h1>
                <button onclick="toggleModal(true)" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm"><i class="fas fa-plus ml-2"></i>إضافة كتاب جديد</button>
            </div>
            
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 overflow-hidden shadow-sm">
                <table class="w-full text-right"><thead class="bg-gray-50 dark:bg-gray-700/50 text-xs font-bold text-gray-500 uppercase"><tr><th class="p-4">عنوان الكتاب</th><th class="p-4">المؤلف</th><th class="p-4">التصنيف</th><th class="p-4">النسخ المتاحة</th></tr></thead>
                    <tbody id="books-table-body" class="divide-y divide-gray-100 dark:divide-gray-700 text-sm"></tbody>
                </table>
            </div>
        </section>

        <!-- صفحة إدارة الصلاحيات -->
        <section id="tab-permissions" class="tab-content hidden space-y-6">
            <h1 class="text-2xl font-bold">هيكلية وتوزيع الصلاحيات</h1>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 overflow-hidden shadow-sm">
                <table class="w-full text-right"><thead class="bg-gray-50 dark:bg-gray-700/50 text-xs font-bold text-gray-500"><tr><th class="p-4">اسم المستخدم</th><th class="p-4">الدور الوظيفي</th><th class="p-4">الحالة</th></tr></thead>
                    <tbody id="users-table-body" class="divide-y divide-gray-100 dark:divide-gray-700 text-sm"></tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- نافذة منبثقة لإضافة كتاب -->
    <div id="book-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl max-w-md w-full space-y-4">
            <h3 class="text-lg font-bold">إضافة كتاب إلى المكتبة</h3>
            <input type="text" id="modal-title" placeholder="عنوان الكتاب" class="w-full p-2.5 border rounded-lg dark:bg-gray-700 dark:border-gray-600 text-black dark:text-white">
            <input type="text" id="modal-author" placeholder="المؤلف" class="w-full p-2.5 border rounded-lg dark:bg-gray-700 dark:border-gray-600 text-black dark:text-white">
            <input type="text" id="modal-category" placeholder="التصنيف" class="w-full p-2.5 border rounded-lg dark:bg-gray-700 dark:border-gray-600 text-black dark:text-white">
            <input type="number" id="modal-copies" placeholder="عدد النسخ" class="w-full p-2.5 border rounded-lg dark:bg-gray-700 dark:border-gray-600 text-black dark:text-white" value="1">
            <div class="flex justify-end gap-2"><button onclick="toggleModal(false)" class="px-4 py-2 text-sm text-gray-500">إلغاء</button><button onclick="saveBook()" class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-lg">حفظ الكتاب</button></div>
        </div>
    </div>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('bg-indigo-50', 'text-indigo-600', 'dark:bg-indigo-900/30', 'dark:text-indigo-400'));
            document.getElementById('nav-' + tabId).classList.add('bg-indigo-50', 'text-indigo-600', 'dark:bg-indigo-900/30', 'dark:text-indigo-400');
        }
        function toggleDarkMode() { document.documentElement.classList.toggle('dark'); }
        function toggleModal(show) { document.getElementById('book-modal').classList.toggle('hidden', !show); }

        async function loadData() {
            try {
                const resBooks = await fetch('/api/books');
                const books = await resBooks.json();
                document.getElementById('stat-books-count').innerText = books.length;
                document.getElementById('books-table-body').innerHTML = books.map(b => `
                    <tr><td class="p-4 font-semibold">${b.title}</td><td class="p-4">${b.author}</td><td class="p-4">${b.category}</td><td class="p-4">${b.available_copies} نسخة</td></tr>
                `).join('');

                const resUsers = await fetch('/api/users');
                const users = await resUsers.json();
                document.getElementById('stat-users-count').innerText = users.length;
                document.getElementById('users-table-body').innerHTML = users.map(u => `
                    <tr><td class="p-4">${u.name}</td><td class="p-4"><span class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 rounded">${u.role}</span></td><td class="p-4 text-green-500">${u.status}</td></tr>
                `).join('');
            } catch (err) { console.error('فشل في جلب البيانات:', err); }
        }

        async function saveBook() {
            const data = {
                title: document.getElementById('modal-title').value,
                author: document.getElementById('modal-author').value,
                category: document.getElementById('modal-category').value,
                copies: parseInt(document.getElementById('modal-copies').value) || 1
            };
            await fetch('/api/books', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            toggleModal(false);
            loadData();
        }

        window.onload = loadData;
    </script>
</body>
</html>
